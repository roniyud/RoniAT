{
  "ConnectionStrings": {
    "TradingDb": "Data Source=storage/roniat.db"
  },
  "Broker": {
    "Mode": "Paper"
  },
  "Risk": {
    "MaxContractsPerSignal": 7,
    "AllowedSymbols": [ "MNQ1!" ],
    "EnableAutoTrading": true,
    "RejectDuplicateSignals": true,
    "DuplicateWindowSeconds": 120,
    "AllowPositionStacking": false,
    "TradingLocked": false,
    "EmergencyStopActive": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
